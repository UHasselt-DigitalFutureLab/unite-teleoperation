# ==========================================================================
# Unity .gitignore (based on GitHub's official Unity template)
# What IS committed for a portable clone: Assets/, Packages/, ProjectSettings/
# Everything below is machine-generated or user-specific.
# ==========================================================================

# Unity generated folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Addressables build cache
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# Unity Recorder / Asset Store Tools / Version Control artifacts
/[Aa]ssets/[Aa]ssetStoreTools*
/[Aa]ssets/Plugins/Editor/JetBrains*

# Autogenerated IDE / project files (Unity regenerates these on open)
.vs/
.vscode/
.idea/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.unityproj
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash / info dumps
sysinfo.txt
crashlytics-build.properties

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Scratch / temporary working dirs (not part of the project)
/tmp/
/qa/

# OS files
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db

# Claude Code local session dir (machine-specific; keep out of repo)
.claude/
