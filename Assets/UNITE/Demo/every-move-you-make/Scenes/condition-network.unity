  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 687cc32b40bc4bd4a44e2fb33d5edbf1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unite.Kernel::Unite.Kernel.DataCaptureAndLoggingModule
  captureImplementations:
  - {fileID: 1276852338}
  metricDefinitions:
  - metricId: completion-time
    unit: s
    calculationProcedure: Timestamp of target-region-entry minus trial-start timestamp.
    thresholds: Capped by the 300 s elapsed-time criterion.
    aggregationRule: Report per condition and aggregate across participants using
      the declared analysis plan.
    startEvent: trial-start
    stopEvent: target-region-entry
  - metricId: pause-count
    unit: count
    calculationProcedure: Count gaps between non-neutral raw operator-input events
      greater than or equal to the configured uplink delay.
    thresholds: Gap threshold equals uplinkDelayMilliseconds exactly.
    aggregationRule: Report per trial and aggregate by condition.
    startEvent: trial-start
    stopEvent: trial-ended
  - metricId: completion-rate
    unit: ratio
    calculationProcedure: For timeout trials, map final rover position to the nearest
      of 101 successful-reference-trajectory points and divide its zero-based index
      by 100.
    thresholds: Defined only for timeout trials; successful trials equal 1.
    aggregationRule: Report per trial and aggregate by condition.
    startEvent: trial-start
    stopEvent: trial-ended
